{
  "name": "enterprise-ai-implementation-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:evidence": "tsx scripts/capture-evidence.ts",
    "capture:video": "tsx scripts/capture-demo.ts",
    "proof:check": "tsx scripts/proof-check.ts",
    "proof:bundle": "tsx scripts/build-proof-bundle.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:offline": "tsx scripts/eval.ts",
    "eval:smoke": "tsx scripts/eval.ts --smoke",
    "eval:live": "tsx scripts/eval.ts --live",
    "eval:calibration:generate": "tsx scripts/calibration.ts",
    "eval:calibration:judge": "tsx scripts/calibration.ts --judge",
    "eval:calibration:report": "tsx scripts/calibration.ts --report",
    "eval:baseline": "tsx scripts/eval.ts --write-baseline",
    "eval:check": "tsx scripts/eval-check.ts",
    "infra:install": "npm --prefix infra install",
    "infra:synth": "npm --prefix infra run synth"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1090.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-sqs": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.1.3",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "next": "16.3.0",
    "openid-client": "^6.8.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "description": "Multi-tenant AI implementation workbench: requirements intake, AI scoping plans, approvals, task delivery, and audit trails on an AWS-native backbone."
}
