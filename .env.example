# Copy to .env and adjust. Defaults target local Docker + LocalStack.

# --- Database (Neon/pgvector pooled runtime in production) ---
DATABASE_URL=postgres://workbench:workbench@localhost:5433/workbench
# Owner/admin connection used only for migrations, seed, and expired-demo cleanup.
# This intentionally matches the local Docker owner so a fresh copy works.
# In production, replace it with a separate privileged role from DATABASE_URL.
DATABASE_ADMIN_URL=postgres://workbench:workbench@localhost:5433/workbench

# --- Auth ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- AWS ---
# In production, drop AWS_ENDPOINT_URL and rely on IAM roles / real credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

S3_BUCKET=workbench-documents
JOBS_QUEUE_URL=http://localhost:4566/000000000000/workbench-jobs

# --- AI ---
# "mock" runs fully offline with deterministic output; "bedrock" calls AWS Bedrock.
AI_PROVIDER=mock
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
EMBEDDING_PROVIDER=mock
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional portability/evaluation adapter; never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929
# Leave blank for deterministic project assignment; pin a variant for demos.
PROMPT_VARIANT=

# --- Misc ---
LOG_LEVEL=info
