# Copy to .env and adjust. Defaults target local Docker + LocalStack.

# --- Database (Neon/pgvector pooled runtime in production) ---
DATABASE_URL=postgres://workbench:workbench@localhost:5433/workbench
# Owner/admin connection used only for migrations, seed, and expired-demo cleanup.
# This intentionally matches the local Docker owner so a fresh copy works.
# In production, replace it with a separate privileged role from DATABASE_URL.
DATABASE_ADMIN_URL=postgres://workbench:workbench@localhost:5433/workbench

# --- Auth ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# AES-256-GCM key material for OIDC/webhook secrets. Generate with:
# openssl rand -base64 32
# Required in production; keep separate from SESSION_SECRET. Local development
# may leave this blank and use the session secret as a compatibility fallback.
APP_ENCRYPTION_KEY=
# Optional default org connection slug shown as the password-login SSO button.
OIDC_DEFAULT_CONNECTION=

# --- AWS ---
# In production, drop AWS_ENDPOINT_URL and rely on IAM roles / real credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
# Hosted Vercel only: short-lived credentials from the CDK-created OIDC role.
# Leave these blank for local Docker/LocalStack.
AWS_ROLE_ARN=
AWS_OIDC_AUDIENCE=https://vercel.com/bmccarthy96s-projects

S3_BUCKET=workbench-documents
JOBS_QUEUE_URL=http://localhost:4566/000000000000/workbench-jobs
# Hosted showcase only: ARN from the CDK DemoControlFunctionArn output.
DEMO_CONTROL_FUNCTION_ARN=

# --- AI ---
# "mock" runs fully offline with deterministic output; "bedrock" calls AWS Bedrock.
AI_PROVIDER=mock
WORKBENCH_ENV_MODE=local
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
EMBEDDING_PROVIDER=mock
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional portability/evaluation adapter; never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929
# Leave blank for deterministic project assignment; pin a variant for demos.
PROMPT_VARIANT=

# --- Public demo guardrails ---
# Public workspaces get two live generations by default; seeded evidence covers
# the rest of the walkthrough. Staging can temporarily raise this for QA.
DEMO_MAX_GENERATION_JOBS=2
DEMO_MAX_ACTIVE_WORKSPACES=20
DEMO_MAX_ACTIVE_PER_NETWORK=4
DEMO_MAX_DAILY_SPEND_USD=1
DEMO_MAX_MONTHLY_SPEND_USD=15

# --- Misc ---
LOG_LEVEL=info
# Used for canonical and social metadata. Vercel supplies its production URL
# automatically when this is omitted in a hosted deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional observability host ports ---
# Change these only if another local stack already uses the standard ports.
WORKBENCH_OTEL_GRPC_PORT=4317
WORKBENCH_OTEL_HTTP_PORT=4318
WORKBENCH_OTEL_PROMETHEUS_PORT=9464
# Set this when running the worker with the observability profile. The worker
# otherwise keeps tracing disabled so a local app does not emit connection
# errors when no collector is running.
# WORKBENCH_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
